# Copy to .env and adjust. All values shown are the defaults.

DQA_DATA_ROOT=./data          # run artifacts and the SQLite registry
DQA_RULE_PACK=./rules/default_pack.yaml
DQA_LOG_LEVEL=INFO
DQA_MAX_WORKERS=2             # concurrent assessments
DQA_RETENTION_DAYS=7          # runs purged after this many days
DQA_API_PREFIX=/api           # must match VITE_API_BASE_URL on the frontend
DQA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Accounts (dqa/auth/). The session is an HttpOnly cookie.
DQA_SESSION_DAYS=7            # how long a sign-in lasts
DQA_COOKIE_SECURE=false       # set true whenever the API is served over https
DQA_COOKIE_SAMESITE=lax       # "none" only for a frontend on another site, with SECURE=true
