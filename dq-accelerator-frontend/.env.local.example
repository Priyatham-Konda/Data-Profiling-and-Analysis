# Copy to .env.local and set to point at a real dqa.api backend.
# Left unset (or commented), the app talks to the in-browser MSW mock.
# Setting this ALSO disables the mock (see main.jsx) -- once a real backend
# is configured, requests go to it, not to fake data.
# Full contract, with examples: API_CONTRACT.md (revision 5)
#
# Must be an https:// address before real Salesforce credentials are
# entered: the client secret travels in a request body, and over plain
# http anyone on the network can read it. http://localhost is fine for dev.
# VITE_API_BASE_URL=<your-backend-url>

# Endpoints this app calls, all relative to VITE_API_BASE_URL.
# Any non-2xx: { error: "..." } (or "detail"), shown to the user verbatim;
# Salesforce errors also carry errorCode.
#
# --- File runs ---------------------------------------------------------------
#
#   POST   /runs
#     multipart/form-data, part "file"
#     -> 201 { id, file, status: "processing" }
#     -> 413 too large, 415 bad extension/type, 400 empty/unparseable
#
#   GET    /runs[?include=all]
#     -> 200 [{ id, file, status, overall? }]          overall only if completed
#     standalone runs only; ?include=all adds Salesforce object runs (with assessmentId)
#
#   GET    /runs/{id}
#     processing    -> { id, file, status, stage, stageIndex, stageCount, progress, stageDetail? }
#     awaiting_cdes -> { id, file, status, records, columns, cdes }
#     failed        -> { id, file, status, error }
#     completed     -> { id, file, status, overall, records, cdes, scores: { dimKey: number|null },
#                        columns, sampled, sampledRows, parseWarnings, cdeOverridden,
#                        notAssessed?: { dimKey: reason } }
#     object runs also carry assessmentId and source { type: "salesforce", orgName, object, label }
#
#   GET    /runs/{id}/dimensions/{dim}
#     -> 200 { key, score, rules: [{ id, name, passRate, column, severity, evaluated, failed }] }
#     not assessed -> { key, score: null, rules: [], notAssessedReason }
#
#   GET    /runs/{id}/dimensions/{dim}/rules/{ruleId}/examples?limit=10
#     -> 200 { ruleId, ruleName, passRate, total, examples: [{ row, column, value, reason }] }
#     -> 404 unknown ruleId
#
#   GET    /runs/{id}/profile
#     -> 200 { columns: [{ name, inferredType, semanticType, fillRate, distinctRatio,
#                           sampleValues, isCde, cdeScore, cdeReason, salesforce? }] }
#     salesforce (object runs) -> { label, type, custom, required, referenceTo, picklistValues, length }
#     -> 409 still in its first processing phase
#
#   PUT    /runs/{id}/cdes
#     body { columns: [name, ...] }
#     -> 202 { id, status: "processing" }
#     -> 400 unknown column or empty selection
#     -> 409 not awaiting_cdes/completed, or an object run in awaiting_cdes
#
#   GET    /runs/{id}/report?type=summary|in-depth
#     -> 200 PDF, Content-Disposition: attachment
#     -> 409 run not completed
#
#   GET    /runs/{id}/data
#     -> 200 CSV, Content-Disposition: attachment; every field and record the run was
#        assessed on (Id first and a UTF-8 BOM for Salesforce objects; the upload itself otherwise)
#     -> 409 until profiling has finished, 404 not found
#
#   DELETE /runs/{id}
#     -> 204
#     -> 404 not found, 409 object run (delete its assessment instead)
#
# --- Salesforce connections (revision 5) --------------------------------------
#
#   POST   /salesforce/connections
#     body { instanceUrl, clientId, clientSecret }      secret sent once, never returned
#     -> 201 { id, state, environment, orgId, orgName, orgEdition, instanceUrl,
#              username, connectedAt, expiresAt, closedReason, assessmentId }
#     -> 400 invalid_url / missing field, 422 invalid_client | flow_not_enabled |
#        no_run_as_user | api_disabled | failed, 502 unreachable
#
#   GET    /salesforce/connections/{id}
#     -> 200 connection (as above); state connected|closed,
#        closedReason extracted|disconnected|idle
#     -> 404 unknown or lost on restart
#
#   GET    /salesforce/connections/{id}/objects[?include=all]
#     -> 200 { objects: [{ name, label, custom, recordCount, suggested }], hiddenCount }
#     -> 404, 409 not connected
#
#   DELETE /salesforce/connections/{id}
#     -> 204
#     -> 404, 409 an assessment is still downloading from it
#
# --- Assessments (revision 5) --------------------------------------------------
#
#   POST   /assessments
#     body { source: { type: "salesforce", connectionId }, objects: [name, ...] }  max 25
#     -> 201 { id, name, status: "processing", runs: [{ id, object, label, status }] }
#     -> 400 empty/too many/duplicate/unknown object, 404 connection, 409 connection closed or used
#
#   GET    /assessments
#     -> 200 [{ id, name, status, objects, overall? }]
#
#   GET    /assessments/{id}
#     every status  -> { id, name, status, source: { type, orgName, orgId, environment }, runs: [...] }
#                      each entry in runs: the GET /runs/{id} shape, minus file, plus object and label
#     processing    -> + progress
#     completed     -> + overall, records, objects, partial, scores, notAssessed
#
#   PUT    /assessments/{id}/cdes
#     body { objects: { [objectName]: [column, ...] } }
#     -> 202 { id, status: "processing" }
#     -> 400 missing awaiting object / unknown object or column, 409 processing or failed
#
#   GET    /assessments/{id}/report?type=summary|in-depth
#     -> 200 PDF, Content-Disposition: attachment
#     -> 409 not completed
#
#   GET    /assessments/{id}/data
#     -> 200 ZIP, one CSV per object with data, named <ObjectApiName>.csv
#     -> 409 while any object is still downloading or first profiling, or no object has data
#
#   DELETE /assessments/{id}
#     -> 204 (removes its object runs too)
#     -> 404
