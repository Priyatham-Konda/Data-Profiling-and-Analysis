# Copy to .env in this folder on the server. The copy is git-ignored: keep it
# out of the repository.

# The domain people will open, already pointing at the server's Elastic IP.
# Caddy gets its HTTPS certificate automatically. ":80" serves plain http by
# IP address, for a first test only, together with DQA_COOKIE_SECURE=false.
SITE_ADDRESS=dq.example.com

# Where the images come from: your Amazon ECR registry, and which build.
# "latest" is what both methods push; a commit SHA pins an earlier build.
REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=latest

# true whenever SITE_ADDRESS is a domain (HTTPS). false only with ":80".
DQA_COOKIE_SECURE=true

# Concurrent assessments, days a run is kept, days a sign-in lasts.
DQA_MAX_WORKERS=2
DQA_RETENTION_DAYS=7
DQA_SESSION_DAYS=7
